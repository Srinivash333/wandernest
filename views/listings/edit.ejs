<% layout("layouts/boilerplate") %>

<div class="container py-4">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
            <div class="card border rounded-4 p-4 shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold m-0">Edit Listing</h3>
                    <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill">Cancel</a>
                </div>

                <!-- Original Image Preview -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Image Preview</label>
                    <div class="rounded-3 overflow-hidden" style="max-height: 200px;">
                        <img src="<%= listing.image?.url || originalImageUrl %>" class="w-100 h-100 object-fit-cover" alt="<%= listing.title %>">
                    </div>
                </div>

                <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation">
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input 
                            name="listing[title]" 
                            id="title"
                            value="<%= listing.title %>" 
                            type="text" 
                            class="form-control rounded-3" 
                            required
                        >
                        <div class="invalid-feedback">Please enter a valid title.</div>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label for="category" class="form-label fw-semibold">Category</label>
                        <select name="listing[category]" id="category" class="form-select rounded-3" required>
                            <% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Beach", "Boats"]; %>
                            <% for (let cat of categories) { %>
                                <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea 
                            name="listing[description]" 
                            id="description"
                            rows="4" 
                            class="form-control rounded-3" 
                            required
                        ><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please enter a description.</div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label for="image-url" class="form-label fw-semibold">Image URL</label>
                        <input 
                            name="listing[image][url]" 
                            id="image-url"
                            value="<%= listing.image?.url %>" 
                            class="form-control rounded-3"
                        >
                    </div>

                    <!-- Price & Location in a row -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label fw-semibold">Price per night (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input 
                                    name="listing[price]" 
                                    id="price"
                                    type="number" 
                                    min="0" 
                                    value="<%= listing.price %>" 
                                    class="form-control rounded-end-3" 
                                    required
                                >
                                <div class="invalid-feedback">Please enter the price.</div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <input 
                                name="listing[location]" 
                                id="location"
                                value="<%= listing.location %>" 
                                class="form-control rounded-3" 
                                required
                            >
                            <div class="invalid-feedback">Please enter the location.</div>
                        </div>
                    </div>

                    <!-- Country -->
                    <div class="mb-4">
                        <label for="country" class="form-label fw-semibold">Country</label>
                        <input 
                            name="listing[country]" 
                            id="country"
                            value="<%= listing.country %>" 
                            class="form-control rounded-3" 
                            required
                        >
                        <div class="invalid-feedback">Please enter the country.</div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-reserve w-100 py-3 rounded-pill text-white fw-bold shadow-sm">
                        Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
