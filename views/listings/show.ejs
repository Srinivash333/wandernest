<% layout("layouts/boilerplate") %>

<div class="container py-4">
    <!-- Listing Title and Quick Actions -->
    <div class="row">
        <div class="col-12 col-lg-10 offset-lg-1">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="fw-bold mb-1"><%= listing.title %></h2>
                    <div class="d-flex align-items-center gap-2 text-secondary small">
                        <span><i class="fa-solid fa-star star-gold"></i> <%= listing.reviews && listing.reviews.length > 0 ? (4.5 + (listing.reviews.length * 0.1 > 0.4 ? 0.4 : listing.reviews.length * 0.1)).toFixed(2) : "New" %></span>
                        <span>·</span>
                        <a href="#reviews-section" class="text-secondary text-decoration-underline fw-semibold"><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %></a>
                        <span>·</span>
                        <span class="text-dark fw-semibold"><i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %>, <%= listing.country %></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-2 mt-sm-0">
                    <button class="btn btn-outline-dark btn-sm rounded-pill px-3 d-flex align-items-center gap-2" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
                    </button>
                    <button class="btn btn-outline-dark btn-sm rounded-pill px-3 d-flex align-items-center gap-2">
                        <i class="fa-regular fa-heart"></i> Save
                    </button>
                </div>
            </div>

            <!-- Hero Image Banner -->
            <div class="show-hero-container position-relative mb-4 overflow-hidden rounded-4 shadow-sm">
                <img 
                    src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" 
                    class="w-100 show-hero-img" 
                    alt="<%= listing.title %>"
                >
                <% if (listing.category) { %>
                    <span class="badge position-absolute top-0 start-0 m-3 bg-dark bg-opacity-75 fs-6 rounded-pill px-3 py-2">
                        <%= listing.category %>
                    </span>
                <% } %>
            </div>

            <!-- Content Grid: Details & Booking Card -->
            <div class="row g-4">
                <!-- Left Column: Details, Amenities, Host info -->
                <div class="col-12 col-md-7">
                    <!-- Host Header -->
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1">
                                Entire home hosted by <%= listing.owner ? listing.owner.username : "Wandernest Host" %>
                            </h4>
                            <p class="text-secondary mb-0 small">4 guests · 2 bedrooms · 2 beds · 2 baths</p>
                        </div>
                        <div class="host-avatar rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-5">
                            <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : "H" %>
                        </div>
                    </div>

                    <!-- Highlight Badges -->
                    <div class="py-3 border-bottom d-flex flex-column gap-3">
                        <div class="d-flex gap-3 align-items-center">
                            <i class="fa-solid fa-door-open fs-4 text-secondary"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Self check-in</h6>
                                <small class="text-secondary">Check yourself in with the smartlock.</small>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <i class="fa-solid fa-location-dot fs-4 text-secondary"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Great location</h6>
                                <small class="text-secondary">95% of recent guests gave the location a 5-star rating.</small>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <i class="fa-solid fa-calendar fs-4 text-secondary"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Free cancellation for 48 hours</h6>
                                <small class="text-secondary">Get a full refund if you change your mind.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="py-4 border-bottom">
                        <h5 class="fw-bold mb-3">About this space</h5>
                        <p class="text-secondary lh-lg mb-0" style="white-space: pre-line;">
                            <%= listing.description %>
                        </p>
                    </div>

                    <!-- Amenities -->
                    <div class="py-4 border-bottom">
                        <h5 class="fw-bold mb-3">What this place offers</h5>
                        <div class="row g-3">
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-wifi fs-5"></i>
                                <span>High-speed Wifi</span>
                            </div>
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-square-parking fs-5"></i>
                                <span>Free parking on premises</span>
                            </div>
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-snowflake fs-5"></i>
                                <span>Air conditioning</span>
                            </div>
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-kitchen-set fs-5"></i>
                                <span>Fully equipped kitchen</span>
                            </div>
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-tv fs-5"></i>
                                <span>HDTV with Netflix</span>
                            </div>
                            <div class="col-6 d-flex align-items-center gap-3 text-secondary">
                                <i class="fa-solid fa-shield-halved fs-5"></i>
                                <span>Carbon monoxide alarm</span>
                            </div>
                        </div>
                    </div>

                    <!-- Owner Action Buttons -->
                    <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                        <div class="py-4 border-bottom d-flex gap-3">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
                                <i class="fa-solid fa-pen-to-square me-2"></i> Edit Listing
                            </a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                <button class="btn btn-outline-danger rounded-pill px-4">
                                    <i class="fa-solid fa-trash me-2"></i> Delete Listing
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>

                <!-- Right Column: Booking Card (Airbnb Floating Box) -->
                <div class="col-12 col-md-5">
                    <div class="card booking-card shadow-lg border rounded-4 p-4 sticky-top" style="top: 6rem; z-index: 10;">
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <div>
                                <span class="fs-3 fw-bold">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="text-secondary"> / night</span>
                            </div>
                            <div class="small fw-semibold">
                                <i class="fa-solid fa-star star-gold"></i> <%= listing.reviews && listing.reviews.length > 0 ? (4.5 + (listing.reviews.length * 0.1 > 0.4 ? 0.4 : listing.reviews.length * 0.1)).toFixed(2) : "New" %>
                            </div>
                        </div>

                        <!-- Date selection box -->
                        <div class="border rounded-3 mb-3 overflow-hidden">
                            <div class="row g-0 border-bottom">
                                <div class="col-6 p-2 border-end">
                                    <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Check-in</label>
                                    <input type="date" class="form-control border-0 p-0 shadow-none small" value="2026-11-01">
                                </div>
                                <div class="col-6 p-2">
                                    <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Checkout</label>
                                    <input type="date" class="form-control border-0 p-0 shadow-none small" value="2026-11-06">
                                </div>
                            </div>
                            <div class="p-2">
                                <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Guests</label>
                                <select class="form-select border-0 p-0 shadow-none small">
                                    <option>1 guest</option>
                                    <option selected>2 guests</option>
                                    <option>3 guests</option>
                                    <option>4+ guests</option>
                                </select>
                            </div>
                        </div>

                        <button class="btn btn-reserve w-100 py-3 rounded-3 text-white fw-bold mb-3" onclick="alert('Booking feature reservation preview: You won\'t be charged yet!');">
                            Reserve
                        </button>
                        <p class="text-center text-muted small mb-3">You won't be charged yet</p>

                        <!-- Price calculation breakdown -->
                        <div class="d-flex justify-content-between mb-2 small text-secondary">
                            <span>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> x 5 nights</span>
                            <span>₹<%= ((listing.price || 0) * 5).toLocaleString("en-IN") %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small text-secondary">
                            <span>Cleaning fee</span>
                            <span>₹800</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small text-secondary">
                            <span>Wandernest service fee</span>
                            <span>₹1,200</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 small text-secondary">
                            <span>Taxes (18% GST)</span>
                            <span>₹<%= Math.round((listing.price || 0) * 5 * 0.18).toLocaleString("en-IN") %></span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>Total before taxes</span>
                            <span>₹<%= ((listing.price || 0) * 5 + 2000).toLocaleString("en-IN") %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mapbox Map Section -->
            <div class="py-5 border-top mt-4">
                <h4 class="fw-bold mb-2">Where you'll be</h4>
                <p class="text-secondary mb-3"><i class="fa-solid fa-map-pin text-danger me-2"></i> <%= listing.location %>, <%= listing.country %></p>
                
                <div id="map" class="map-box shadow-sm rounded-4 border"></div>
                
                <div class="d-flex align-items-center gap-2 mt-2 text-muted small">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Exact location coordinates provided upon booking confirmation.</span>
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="py-4 border-top" id="reviews-section">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <h4 class="fw-bold m-0"><i class="fa-solid fa-star star-gold"></i> <%= listing.reviews && listing.reviews.length > 0 ? (4.5 + (listing.reviews.length * 0.1 > 0.4 ? 0.4 : listing.reviews.length * 0.1)).toFixed(2) : "New" %></h4>
                    <span class="fs-4">·</span>
                    <h4 class="fw-bold m-0"><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'Review' : 'Reviews' %></h4>
                </div>

                <!-- Add Review Form (for logged-in users) -->
                <% if (currUser) { %>
                    <div class="card p-4 rounded-4 border shadow-sm mb-5 review-form-card">
                        <h5 class="fw-bold mb-3">Leave a Review</h5>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Rating</label>
                                <!-- Interactive Star Rating Input -->
                                <div class="star-rating-selector d-flex gap-2 fs-4 text-warning">
                                    <input type="radio" id="rate5" name="review[rating]" value="5" class="d-none" checked>
                                    <label for="rate5" class="star-label cursor-pointer" title="5 stars"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate4" name="review[rating]" value="4" class="d-none">
                                    <label for="rate4" class="star-label cursor-pointer" title="4 stars"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate3" name="review[rating]" value="3" class="d-none">
                                    <label for="rate3" class="star-label cursor-pointer" title="3 stars"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate2" name="review[rating]" value="2" class="d-none">
                                    <label for="rate2" class="star-label cursor-pointer" title="2 stars"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate1" name="review[rating]" value="1" class="d-none">
                                    <label for="rate1" class="star-label cursor-pointer" title="1 star"><i class="fa-solid fa-star"></i></label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label fw-semibold">Your Review</label>
                                <textarea 
                                    name="review[comment]" 
                                    id="comment" 
                                    rows="4" 
                                    class="form-control rounded-3" 
                                    placeholder="Tell future guests about your stay, hospitality, and surroundings..." 
                                    required
                                ></textarea>
                                <div class="invalid-feedback">Please write a comment for your review.</div>
                            </div>

                            <button type="submit" class="btn btn-dark rounded-pill px-4">Submit Review</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border rounded-4 p-4 mb-4 text-center">
                        <p class="mb-2 fw-semibold">Have you stayed at this place?</p>
                        <p class="text-secondary small mb-3">Please log in or sign up to leave an authentic review.</p>
                        <a href="/login" class="btn btn-outline-dark btn-sm rounded-pill px-4">Log in to Review</a>
                    </div>
                <% } %>

                <!-- Reviews Grid -->
                <% if (listing.reviews && listing.reviews.length > 0) { %>
                    <div class="row row-cols-1 row-cols-md-2 g-4">
                        <% for (let review of listing.reviews) { %>
                            <div class="col">
                                <div class="card h-100 border rounded-4 p-3 review-card shadow-sm">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="review-avatar rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold small">
                                                <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0"><%= review.author ? review.author.username : "Wandernest Guest" %></h6>
                                                <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString("en-US", { month: "short", year: "numeric" }) %></small>
                                            </div>
                                        </div>
                                        
                                        <div class="text-warning small">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <i class="fa-solid fa-star <%= i <= review.rating ? 'text-warning' : 'text-secondary opacity-25' %>"></i>
                                            <% } %>
                                        </div>
                                    </div>

                                    <p class="card-text text-secondary mt-2 mb-3">
                                        <%= review.comment %>
                                    </p>

                                    <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto">
                                            <button class="btn btn-sm btn-link text-danger text-decoration-none p-0">
                                                <i class="fa-solid fa-trash-can me-1"></i> Delete
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <p class="text-muted fst-italic">No reviews yet. Be the first to share your experience!</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Pass data to Mapbox script -->
<script>
    const mapToken = "<%= mapToken %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>
<script src="/js/map.js"></script>