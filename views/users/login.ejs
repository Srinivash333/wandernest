<% layout("layouts/boilerplate") %>

<div class="container py-5">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2 col-lg-5 offset-lg-3">
            <div class="card border rounded-4 p-4 shadow-sm bg-white auth-card">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-compass brand-icon display-5 mb-2"></i>
                    <h3 class="fw-bold">Log in to Wandernest</h3>
                    <p class="text-secondary small">Welcome back! Please enter your details.</p>
                </div>

                <form action="/login" method="POST" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                            <input 
                                name="username" 
                                id="username" 
                                type="text" 
                                class="form-control rounded-end-3" 
                                placeholder="Enter your username" 
                                required
                            >
                            <div class="invalid-feedback">Please enter your username.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="password" class="form-label fw-semibold mb-0">Password</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input 
                                name="password" 
                                id="password" 
                                type="password" 
                                class="form-control rounded-end-3" 
                                placeholder="Enter your password" 
                                required
                            >
                            <div class="invalid-feedback">Please enter your password.</div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-reserve w-100 py-3 rounded-pill text-white fw-bold shadow-sm mb-3">
                        Log In
                    </button>

                    <!-- Demo Credentials Info Box -->
                    <div class="alert alert-light border rounded-3 p-3 mb-3 text-center small text-secondary">
                        <div class="fw-semibold text-dark mb-1"><i class="fa-solid fa-key me-1 text-warning"></i> Demo Account:</div>
                        Username: <code>demouser</code> &nbsp;|&nbsp; Password: <code>demo123</code>
                    </div>

                    <div class="text-center">
                        <p class="text-secondary small mb-0">
                            Don't have an account? <a href="/signup" class="fw-bold text-dark text-decoration-underline">Sign up</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
