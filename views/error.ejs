<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="alert alert-danger col-6 offset-3" role="alert">
        <svg class="bi flex-shrink-0 me-2"
             role="img"
             aria-label="Danger:">
            <use xlink:href="#exclamation-triangle-fill"></use>
        </svg>

        <p class="alert-heading"><%= err.message %></p>
    </div>
</div>