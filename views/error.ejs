<% layout("/layouts/boilerplate") %>

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="error-illustration mb-4">
                <i class="fa-solid fa-triangle-exclamation text-danger display-1 opacity-75"></i>
            </div>
            <h1 class="fw-bold mb-3 display-5">Oops! Something went wrong</h1>
            <p class="text-secondary fs-5 mb-4">
                <%= typeof message !== 'undefined' ? message : (err && err.message ? err.message : 'We couldn\'t find the page you\'re looking for.') %>
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/listings" class="btn btn-reserve rounded-pill px-4 py-2 text-white fw-semibold">
                    <i class="fa-solid fa-house me-2"></i> Return to Stays
                </a>
                <button onclick="window.history.back()" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold">
                    Go Back
                </button>
            </div>
        </div>
    </div>
</div>